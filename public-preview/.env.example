# ==============================================================================
# The Grand ADP Hotel Management Platform — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (DEV1-TASK-01 Foundation)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format:
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grand_hotel_db

# Connection Pool Settings (Optional overrides for serverless / edge vs local)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Guest Session & QR Verification Secrets (DEV3-TASK-01 Prerequisite)
# ------------------------------------------------------------------------------
# HMAC secret used to verify in-room static QR signatures (min 32 characters)
GUEST_QR_HMAC_SECRET=dev_qr_hmac_secret_key_minimum_32_chars_long_adp_hotel!

# ------------------------------------------------------------------------------
# Google Gemini AI Assistant Configuration (GUEST-HELP-03)
# ------------------------------------------------------------------------------
# Official Google Gemini API Key (server-side only; never use NEXT_PUBLIC_ prefix)
# For AWS deployment, fetch from AWS Secrets Manager: secret "grand-hotel/gemini-api"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


